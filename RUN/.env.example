# ═══════════════════════════════════════════════════════════
# Environment Variables for Live Trading Bot
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control!

# Binance API credentials (read + trade permissions, NO withdraw)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Dashboard Access Password Protection (leave empty for open access)
DASHBOARD_PASSWORD=admin_password_123

# Run mode override (optional — can also set in config.yaml)
# Valid: BACKTEST, DRY_RUN, TESTNET, LIVE
RUN_MODE=DRY_RUN
